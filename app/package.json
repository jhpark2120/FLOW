{
  "name": "flow-media-downloader",
  "version": "0.1.0",
  "description": "FLOW Windows media downloader",
  "author": "FLOW",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/engine.test.cjs",
    "desktop": "electron .",
    "package:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.9.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.flow.media.downloader",
    "productName": "FLOW",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/flow.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "artifactName": "FLOW-Setup-${version}.${ext}"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  },
  "packageManager": "pnpm@11.25.0"
}
